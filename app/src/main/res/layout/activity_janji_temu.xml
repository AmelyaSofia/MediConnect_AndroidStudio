<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@color/white"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header dengan tombol back -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_button_round"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Kembali"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Buat Janji Temu"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_purple" />
        </RelativeLayout>

        <!-- Info Dokter -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:clickable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgDokterJanji"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="16dp"
                    android:scaleType="centerCrop"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardCornerRadius="40dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNamaDokterJanji"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nama Dokter"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvSpesialisJanji"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Spesialis"
                        android:textSize="14sp"
                        android:textColor="@color/gray_text"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pilih Tanggal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Tanggal"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPilihTanggal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Tanggal"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/primary_purple"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTanggalDipilih"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum dipilih"
            android:textSize="14sp"
            android:textColor="@color/gray_text"
            android:layout_marginBottom="16dp" />

        <!-- Pilih Waktu -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Waktu"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPilihWaktu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Waktu"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/primary_purple"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvWaktuDipilih"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum dipilih"
            android:textSize="14sp"
            android:textColor="@color/gray_text"
            android:layout_marginBottom="24dp" />

        <!-- Catatan -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catatan (opsional)"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Catatan (opsional)"
            android:minLines="3"
            android:gravity="top" />


        <!-- Tombol Konfirmasi -->
        <Button
            android:id="@+id/btnKonfirmasiJanji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Janji Temu"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/accent_green"
            android:textColor="@color/white"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
