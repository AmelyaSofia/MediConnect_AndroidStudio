<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="10dp"
        android:elevation="8dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/logomediconnect"
            android:contentDescription="Logo MediConnect"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo, User 👋"
            android:textColor="#2E2E2E"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSubWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat datang di MediConnect"
            android:textColor="#555555"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/btnLokasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="10dp"
            android:paddingHorizontal="4dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp">


            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Lihat Lokasi RS MediConnect"
                android:textColor="#000000"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CARD LAYANAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_card"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Layanan"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#333333"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Pendaftaran rawat jalan Dan inap\n• Pemantauan status pasien\n• Akses hasil pemeriksaan medis"
            android:textSize="14sp"
            android:textColor="#444444"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
    <!-- INFO HARI INI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_card"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Info Hari Ini"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#333333"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕘 Layanan rawat jalan buka pukul 08.00 – 16.00\n📌 Pastikan data pasien sudah lengkap sebelum mendaftar"
            android:textSize="14sp"
            android:textColor="#444444"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- CARD TIPS -->
    <LinearLayout
        android:id="@+id/tvTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_card"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tips Kesehatan"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#333333"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Minum air putih minimal 8 gelas per hari untuk menjaga hidrasi tubuh."
            android:textSize="14sp"
            android:textColor="#444444"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- DARURAT (FOKUS UTAMA) -->
    <LinearLayout
        android:id="@+id/btnDarurat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/card_service"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/emergency"
            app:tint="#E74C3C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DARURAT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/poppins_semibold" />
    </LinearLayout>

</LinearLayout>
